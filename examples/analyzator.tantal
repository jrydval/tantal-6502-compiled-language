; Jednoduchý logický analyzátor pro PAL-2
; Zaznamenává změny na portu A do kruhového bufferu, počet změn ukazuje
; na displeji a po 2 s bez změny vypíše záznam na TTY.

ring byte[256] log noinit    ; přežije návrat do monitoru
byte PAD_OLD                 ; poslední zaznamenaný stav portu
card changes
byte cur, i

proc show()
  DISP2 = hi(changes)
  DISP1 = lo(changes)
  DISP0 = cur
  SCANDS()
endproc

PADD = $00                   ; port A jako vstup
PAD_OLD = PAD
clear(log)

.cycles <= 40
do
  cur = wait change PAD from PAD_OLD timeout 2 s
  if timedout then exit fi
  log <- cur
  changes += 1
od

show()
for i = 0 until len(log) do
  PRTBYT(log[i])
  OUTSP()
od
CRLF()

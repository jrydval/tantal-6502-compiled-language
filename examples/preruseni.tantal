; Přerušení od časovače RIOT: obsluha počítá tiky a ukládá stav portu A.
; V bufferu samples jsou hodnoty přečtené z portu PAD, ne čísla tiků.
; V emulátoru proto zadejte, co na port přichází, např.:
;   tantal run examples/preruseni.tantal --input PAD=@0:00,@3000:05,@6000:07
; Bez --input se z portu čtou nuly.
ring byte[16] samples
card ticks
byte got, n

interrupt irq proc onTimer()
  ticks += 1
  samples <- PAD
  TIM64I = 16                ; další přerušení za 16 × 64 µs
endproc

TIM64I = 16                  ; spustit časovač s přerušením
while ticks < 10 do od       ; počkat na 10 tiků

atomic
  n = len(samples)
  got = pop(samples)
endatomic

# pal2.target - the PAL-2 computer (a modernized KIM-1)
cpu        = 6502              ; NMOS, no 65C02 yet
clock      = 1000000           ; Hz, 1 MHz
ram        = $0000-$16FF, $2000-$FFF7
org        = $2000
vars       = after-code        ; once the zero page is used up
reserve    = $0200-$16FF       ; loader, user
reserve    = $1750-$177F       ; mirrors of system RIOT $1740-$174F
zp.free    = $00-$EE
vector.irq = $17FE
vector.nmi = $17FA
exit       = $1C4F             ; START, return to monitor
brk        = $1C00             ; SAVE, where the IRQ handler passes a BRK instruction
timeout.timer = $1704          ; timer used by wait ... timeout
rom        = $1800-$1FFF       ; monitor ROM (the emulator only logs calls)
io         = $1700-$177F
include    = pal2.tantal

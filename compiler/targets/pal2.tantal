; pal2.tantal - predefined registers and monitor routines of the PAL-2
; Address source: KIM-1 Quick Reference (Jeff Tranter); the PAL-2 has the KIM-1 memory map.

; user RIOT, ports on the application connector
byte PAD   @ $1700
byte PADD  @ $1701
byte PBD   @ $1702
byte PBDD  @ $1703

; system RIOT: display, keypad (also used by the monitor)
byte SYS_PA   @ $1740
byte SYS_PADD @ $1741
byte SYS_PB   @ $1742
byte SYS_PBDD @ $1743

; user RIOT timer: a write starts a countdown with the given divider
byte TIM1     @ $1704 writeonly    ; 1 us, no interrupt
byte TIM8     @ $1705 writeonly
byte TIM64    @ $1706 writeonly
byte TIM1024  @ $1707 writeonly
byte TIM1I    @ $170C writeonly    ; 1 us, with interrupt
byte TIM8I    @ $170D writeonly
byte TIM64I   @ $170E writeonly
byte TIM1024I @ $170F writeonly

; timer: reads
byte TIMCNT   @ $1706 readonly     ; counter value, disables the interrupt
byte TIMCNTI  @ $170E readonly     ; counter value, enables the interrupt
byte TIMSTAT  @ $1707 readonly
bit  TIMEOUT  = TIMSTAT.7          ; 1 = countdown finished

; monitor routines
extern proc OUTCH(byte c @A)   @ $1EA0   ; character to TTY
extern proc PRTBYT(byte b @A)  @ $1E3B   ; hex byte to TTY
extern proc OUTSP()            @ $1E9E   ; space to TTY
extern proc CRLF()             @ $1E2F
extern proc GETCH(): byte @A   @ $1E5A   ; character from TTY
extern proc SCANDS()           @ $1F1F   ; display from $F9-$FB
extern proc KEYIN()            @ $1F40
extern proc GETKEY(): byte @A  @ $1F6A   ; key 0-$15

byte DISP0 @ $F9   ; monitor display buffer
byte DISP1 @ $FA
byte DISP2 @ $FB

byte[] SEG7_HEX @ $1FE7 readonly   ; 7-segment patterns of digits 0-F in ROM (TABLE)
